menu "SoC Configuration"


menu "CH58x SoC drivers"

    config CH58X_RAM_SIZE_KB
        int "CH58x RAM size (KB)"
        default 128
        range 96 128
        depends on SOC_CH58X

    config SOC_CH58X_UART
        bool "Enable CH58x UART driver"
        default y
        depends on SOC_CH58X

    config SOC_CH58X_GPIO
        bool "Enable CH58x GPIO driver"
        default y
        depends on SOC_CH58X

    config SOC_CH58X_SPI
        bool "Enable CH58x SPI driver"
        default n
        depends on SOC_CH58X

    config SOC_CH58X_I2C
        bool "Enable CH58x I2C driver"
        default n
        depends on SOC_CH58X

    config SOC_CH58X_TIMER
        bool "Enable CH58x TIMER driver"
        default y
        depends on SOC_CH58X

    config SOC_CH58X_ADC
        bool "Enable CH58x ADC driver"
        default y
        depends on SOC_CH58X

    config SOC_CH58X_WDT
        bool "Enable CH58x WDT driver"
        default n
        depends on SOC_CH58X
    
    config SOC_CH58X_PWM
        bool "Enable CH58x PWM driver"
        default n
        depends on SOC_CH58X

    config SOC_CH58X_USB
        bool "Enable CH58x USB driver"
        default n
        depends on SOC_CH58X

rsource "libble/Kconfig"

endmenu

endmenu

menu "Debug Configuration"

choice DEBUG_INTERFACE
    prompt "Debug Interface"
    default DEBUG_UART0
    help
      Select debug output interface

config DEBUG_NONE
    bool "No Debug Output"

config DEBUG_UART0
    bool "UART0 Debug Output"

config DEBUG_UART1
    bool "UART1 Debug Output"

endchoice

config DEBUG_UART_PORT
    int
    default 0 if DEBUG_NONE
    default 1 if DEBUG_UART0
    default 2 if DEBUG_UART1
    help
      Debug UART port number (0=none, 1=UART0, 2=UART1)

endmenu